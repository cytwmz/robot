PORT=3000
SERVE_FRONTEND=true
PUBLIC_BACKEND_BASE_URL=

# Wi-Fi body relay. Use different long random values for the device and browser.
LOOI_WIFI_RELAY_ENABLED=false
LOOI_WIFI_DEVICE_TOKEN=replace-with-a-long-device-token
LOOI_WIFI_CONTROL_TOKEN=replace-with-a-long-browser-token
PUBLIC_WIFI_BODY_DEVICE_ID=looi-s3
PUBLIC_WIFI_BODY_CONTROL_TOKEN=replace-with-a-long-browser-token

LOCAL_BRAIN_ENABLED=true
LOCAL_BRAIN_PROVIDER=fireworks
LOCAL_BRAIN_MODEL=accounts/fireworks/models/gpt-oss-20b
LOCAL_BRAIN_REQUIRE_LOCAL_NETWORK=false
LOCAL_BRAIN_TIMEOUT_MS=20000
LOCAL_BRAIN_EVENT_TIMEOUT_MS=12000
LOCAL_BRAIN_AUTONOMOUS_TIMEOUT_MS=20000
LOCAL_BRAIN_TEMPERATURE=0.15
LOCAL_BRAIN_MAX_OUTPUT_TOKENS=192
LOCAL_BRAIN_TRACE=true

# OpenAI Responses API agent. Set LOCAL_BRAIN_PROVIDER=openai-responses to use it.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_REASONING_EFFORT=none

# API2D uses the OpenAI-compatible Chat Completions API. The browser never receives this key.
API2D_CHAT_ENABLED=true
API2D_API_KEY=
API2D_BASE_URL=https://oa.api2d.net/v1
API2D_MODEL=gpt-4o-mini
# Browser speech recognition and speech synthesis provide turn-by-turn voice locally.
API2D_BROWSER_VOICE_ENABLED=true
API2D_BROWSER_VOICE_LANGUAGE=zh-CN

# Select API2D for normal text chat (not a WebSocket realtime protocol).
LOCAL_BRAIN_PROVIDER=api2d
LOCAL_BRAIN_MODEL=gpt-4o-mini

GEMINI_LIVE_ENABLED=false
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Kore
GEMINI_LIVE_THINKING_LEVEL=minimal
# Preferred for a relay/middle station: the complete Gemini Live WebSocket endpoint.
# The backend injects GEMINI_API_KEY using the auth mode below; do not put the key in this URL.
GEMINI_LIVE_WEBSOCKET_URL=
# query adds ?key=... by default. Other supported values: bearer, x-goog-api-key, none.
GEMINI_LIVE_AUTH_MODE=query
GEMINI_LIVE_API_KEY_QUERY_PARAM=key
GEMINI_LIVE_ALLOW_PUBLIC_RELAY=false
# Backward-compatible old name; prefer GEMINI_LIVE_ALLOW_PUBLIC_RELAY.
GEMINI_LIVE_ALLOW_PUBLIC_TOKEN=false

# Alibaba Cloud Bailian Qwen-Omni Realtime. The API key stays server-side.
QWEN_OMNI_REALTIME_ENABLED=false
DASHSCOPE_API_KEY=
QWEN_OMNI_REALTIME_MODEL=qwen3.5-omni-flash-realtime
QWEN_OMNI_REALTIME_VOICE=Ethan
# Optional: use a workspace regional endpoint or a custom endpoint from Bailian.
# DASHSCOPE_WORKSPACE_ID=
# QWEN_OMNI_REALTIME_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
QWEN_OMNI_REALTIME_ALLOW_PUBLIC=false

ROBOFLOW_WEBRTC_ENABLED=true
ROBOFLOW_WEBRTC_ALLOW_PUBLIC=false
ROBOFLOW_API_KEY=
ROBOFLOW_WORKSPACE=younes-makhchan
ROBOFLOW_WORKFLOW_ID=rf-detr
ROBOFLOW_WORKFLOW_IDS=rf-detr,rf-detr-2
ROBOFLOW_WORKFLOW_SPEC=
ROBOFLOW_IMAGE_INPUT_NAME=image
ROBOFLOW_STREAM_OUTPUT_NAMES=
ROBOFLOW_DATA_OUTPUT_NAMES=predictions
ROBOFLOW_THREAD_POOL_WORKERS=
ROBOFLOW_PROCESSING_TIMEOUT_SECONDS=3600
ROBOFLOW_REQUESTED_PLAN=webrtc-gpu-medium
ROBOFLOW_REQUESTED_REGION=eu
ROBOFLOW_SERVER_URL=https://serverless.roboflow.com
ROBOFLOW_API_BASE_URL=https://api.roboflow.com

FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_API_KEY=
FIREWORKS_TOP_P=1
FIREWORKS_TOP_K=40
FIREWORKS_PRESENCE_PENALTY=0
FIREWORKS_FREQUENCY_PENALTY=0

SERVER_TRACE=true
SERVER_TRACE_POLL_ENDPOINTS=false
SERVER_TRACE_REQUEST_BODIES=true
SERVER_TRACE_RESPONSE_BODIES=true

LOOI_ATTENTION_WINDOW_MS=20000
LOOI_CONVERSATION_WINDOW_MS=30000
LOOI_SPEECH_GATE_EVENT_COOLDOWN_MS=800
LOOI_AUTONOMOUS_SCHEDULER_TICK_MS=1000
LOOI_IDLE_MICRO_MIN_MS=4000
LOOI_IDLE_MICRO_MAX_MS=12000
LOOI_MACRO_DEFAULT_RAMP_MS=160
